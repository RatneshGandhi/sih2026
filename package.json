{
  "name": "nlams-root",
  "version": "1.0.0",
  "description": "National Land Acquisition & Management System - SIH 2026 Full-Stack MVP",
  "private": true,
  "scripts": {
    "migrate": "node server/db/migrations.js",
    "seed": "node server/db/seed.js",
    "db:setup": "node server/db/setupAll.js",
    "db:start": "node -e \"require('./server/db/ensureDb').ensurePostgresRunning()\"",
    "server": "node --watch server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgGreen.bold\" \"node --watch server/index.js\" \"npm --prefix client run dev\""
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
